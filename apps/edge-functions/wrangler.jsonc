{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mentorships-edge-functions",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-16",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {
    "//": "Secrets are set via `wrangler secret put` for each env. Do not commit real values. Required secrets: STRIPE_WEBHOOK_SECRET, INNGEST_EVENT_KEY, PAYPAL_CLIENT_ID, PAYPAL_CLIENT_SECRET, PAYPAL_WEBHOOK_ID, CONVEX_URL, TURNSTILE_SECRET_KEY, B2_ACCESS_KEY_ID, B2_SECRET_ACCESS_KEY, B2_BUCKET_NAME. Optional: B2_REGION, B2_ENDPOINT, INNGEST_APP_ID, PAYPAL_MODE, ALLOWED_ORIGINS."
  }
}
