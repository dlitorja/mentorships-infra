{
  "extends": "./tsconfig.json",
  "include": [
    "next-env.d.ts",
    "**/*.test.ts",
    "**/*.test.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ],
  "compilerOptions": {
    "paths": {
      "@/*": ["./*"],
      "@/convex/_generated/*": ["../../convex/_generated/*"],
      "@mentorships/db": ["../../packages/db/src"],
      "@mentorships/ui": ["../../packages/ui/src"],
      "@mentorships/web": ["../web"],
      "@mentorships/web/*": ["../web/*"],
      "next/server": ["./node_modules/next/server.d.ts"]
    }
  }
}
