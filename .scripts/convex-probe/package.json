{
  "name": "@mentorships-infra/convex-probe",
  "private": true,
  "description": "Tier 1 deterministic shape-scanner for convex-authz's 4-shape taxonomy",
  "version": "0.0.0",
  "scripts": {
    "scan-b": "tsx scan-b.ts ../../convex",
    "scan-d": "tsx scan-d.ts ../../convex",
    "scan": "npm run scan-b && npm run scan-d",
    "diff": "tsx diff.ts",
    "baseline": "tsx diff.ts --update",
    "test": "node --import tsx --test detector.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "tsx": "^4.19.0",
    "typescript": "5.9.3"
  }
}
